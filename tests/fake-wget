#!/bin/sh
# Fake wget for the collector tests: answers with tests/fixtures/<api>/*.json by URL (the last argument),
# fails like a 401/403 when the service's auth header is missing.
F=${FIX:-$(cd "$(dirname "$0")" && pwd)/fixtures}
for u; do :; done
a=" $* "
need() { case "$a" in *"$1"*) ;; *) exit 8 ;; esac; }
case "$u" in
  # RCI: the token tests/fake-ndmc issues or none (before 5.2); any other is refused like ndm does. Requests go to $LOG
  http://127.0.0.1:79/rci/*)
    t=; case "$a" in *" X-NDMA-TKN: "*) t=${a#* X-NDMA-TKN: }; t=${t%% *} ;; esac
    d=; case "$a" in *" --post-data "*) d=${a#* --post-data }; d=${d%" $u "} ;; esac
    echo "rci /${u#*/rci/} ${t:--}${d:+ $d}" >> "${LOG:-/dev/null}"
    [ -z "$t" ] || [ "$t" = Tk0123456789abcdefghijklmnopqrstuvWXYZ ] || { printf '  HTTP/1.1 403 Forbidden\n  X-Detail: 0x2312, not identified\n' >&2; exit 8; } ;;
  # awg-manager with its login on (AWG_KEY): only its API key passes. Requests go to $LOG
  http://127.0.0.1:2222/api/*) echo "awg /${u#*/api/}" >> "${LOG:-/dev/null}"; [ -z "$AWG_KEY" ] || need "Authorization: Bearer $AWG_KEY" ;;
  # availability check: up.test answers 200, bad.test 503, down.test not at all, slow.test after 1 s. Requests go to $LOG; UPBUMP moves the fake uptime file by 120 ms
  *//up.test[:/]* | *//bad.test[:/]* | *//down.test[:/]* | *//slow.test[:/]*)
    echo "check$a" >> "${LOG:-/dev/null}"
    case "$u" in
      *//up.test*) [ -z "$UPBUMP" ] || echo "1000.12 0.00" > "$KEENDASH_UPTIME"; printf '  HTTP/1.1 200 OK\n  Server: up\n' >&2; exit 0 ;;
      *//slow.test*) sleep 1; printf '  HTTP/1.1 200 OK\n' >&2; exit 0 ;;
      *//bad.test*) printf '  HTTP/1.1 503 Service Unavailable\n' >&2; exit 8 ;;
      *) echo "wget: unable to resolve host address" >&2; exit 4 ;;
    esac ;;
  # glances: v4 is absent under /old (v3 only); accepts both logins, requests go to $LOG
  *//glances.test/old/api/4/*) exit 8 ;;
  *//glances.test/*) echo "glances$a" >> "${LOG:-/dev/null}" ;;
  *//spoolman.test/*) ;;
  *//grafana.test/api/health) ;;
  *//grafana.test/*) need "Authorization: Bearer testkey" ;;
  *//portainer.test/*) need "X-API-Key: testkey" ;;
  *//truenas.test/*) need "Authorization: Bearer testkey" ;;
  # Basic base64(":testkey")
  *//kuma.test/*) need "Authorization: Basic OnRlc3RrZXk=" ;;
  # cookie only for admin / p&s=s, percent-encoded
  */api/v2/auth/login) need "username=%61%64%6d%69%6e&password=%70%26%73%3d%73"; echo "  Set-Cookie: SID=test123; HttpOnly; path=/" >&2; exit 0 ;;
  */api/v2/*) need "Cookie: SID=test123" ;;
  # any JSON API of the custom type: no auth required, the request line goes to $LOG
  *//custom.test/*) echo "custom$a" >> "${LOG:-/dev/null}" ;;
  # 409 with a session id until the client repeats it; the /stuck/ path never stops. Requests go to $LOG
  *//transmission.test/stuck/*) printf '  HTTP/1.1 409 Conflict\n  X-Transmission-Session-Id: sess1\n' >&2; exit 8 ;;
  *//transmission.test/*) echo "transmission$a" >> "${LOG:-/dev/null}"
    case "$a" in *" X-Transmission-Session-Id: sess1 "*) ;; *) printf '  HTTP/1.1 409 Conflict\n  X-Transmission-Session-Id: sess1\n' >&2; exit 8 ;; esac ;;
  # login only for the password p"a\ss, JSON-escaped in the body, then the cookie
  *//deluge.test/json) case "$a" in
    *auth.login*) need '--post-data {"method":"auth.login","params":["p\"a\\ss"],"id":1}'; echo "  Set-Cookie: _session_id=abc; Path=/; HttpOnly" >&2 ;;
    *) need "Cookie: _session_id=abc" ;; esac ;;
  # port 5000 needs no login; 8971 only after the login for admin / p"a\ss (JSON-escaped in the body), then the cookie. Requests go to $LOG
  *//frigate.test:5000/*) printf 'frigate%s\n' "$a" >> "${LOG:-/dev/null}" ;;
  *//frigate.test:8971/api/login) printf 'frigate%s\n' "$a" >> "${LOG:-/dev/null}"
    need '--post-data {"user":"admin","password":"p\"a\\ss"}'; echo "  Set-Cookie: frigate_token=abc; Path=/; HttpOnly" >&2 ;;
  *//frigate.test:8971/*) printf 'frigate%s\n' "$a" >> "${LOG:-/dev/null}"; need "Cookie: frigate_token=abc" ;;
  # Home Assistant: Bearer token only; every request goes to $LOG, an entity without a fixture is a 404
  *//ha.test/*) echo "ha$a" >> "${LOG:-/dev/null}"; need "Authorization: Bearer testkey" ;;
  *//plex.test/*) need "X-Plex-Token: testkey" ;;
  *//immich.test/*) need "x-api-key: testkey" ;;
  *//jellyfin.test/*) need "X-Emby-Token: testkey" ;;
  *//jellyseerr.test/*) need "X-Api-Key: testkey" ;;
  *//lidarr.test/*) need "X-Api-Key: testkey" ;;
  *//bazarr.test/*) need "X-API-KEY: testkey" ;;
  *//tautulli.test/* | *//sabnzbd.test/*) need "apikey=testkey" ;;
  # accepts both; the request line goes to $LOG
  *//nzbget.test/*) echo "nzbget$a" >> "${LOG:-/dev/null}" ;;
  *//sonarr.test/* | *//radarr.test/* | *//prowlarr.test/* | *//overseerr.test/*) need "X-Api-Key: testkey" ;;
esac
case "$u" in
  *//custom.test/html) echo "<html>not json</html>"; exit 0 ;;
  *//custom.test/page) echo "<style>a{b:1}</style>"; exit 0 ;;
  *//custom.test/*) f=media/custom ;;
  */control/stats) f=agh/stats ;;
  */control/clients) f=agh/clients ;;
  */control/filtering/status) f=agh/filtering ;;
  */control/querylog*) f=agh/querylog ;;
  */api/v2/transfer/info) f=media/qb_transfer ;;
  */api/v2/torrents/info*) f=media/qb_torrents ;;
  *//transmission.test/*) f=media/transmission_stats ;;
  *//deluge.test/json) case "$a" in *auth.login*) f=media/deluge_login ;; *) f=media/deluge_ui ;; esac ;;
  */status/sessions) f=media/plex_sessions ;;
  */library/sections) f=media/plex_sections ;;
  */library/sections/*/all*) k=${u#*/library/sections/}; f=media/plex_count_${k%%/*} ;;
  *//sonarr.test/api/v3/queue*) f=media/sonarr_queue ;;
  *//sonarr.test/api/v3/wanted/missing*) f=media/sonarr_missing ;;
  *//sonarr.test/api/v3/calendar*) f=media/sonarr_calendar ;;
  *//radarr.test/api/v3/queue*) f=media/radarr_queue ;;
  *//radarr.test/api/v3/wanted/missing*) f=media/radarr_missing ;;
  *//radarr.test/api/v3/calendar*) f=media/radarr_calendar ;;
  *//lidarr.test/api/v1/queue*) f=media/lidarr_queue ;;
  *//lidarr.test/api/v1/wanted/missing*) f=media/lidarr_missing ;;
  *//bazarr.test/api/badges) f=media/bazarr_badges ;;
  *//tautulli.test/api/v2*) f=media/tautulli_activity ;;
  *//sabnzbd.test/days/api*) f=media/sabnzbd_queue_days ;;
  *//sabnzbd.test/api*) f=media/sabnzbd_queue ;;
  *//nzbget.test/jsonrpc/status) f=media/nzbget_status ;;
  */api/v1/indexer) f=media/prowlarr_indexer ;;
  */api/v1/indexerstatus) f=media/prowlarr_status ;;
  */api/v1/indexerstats*) f=media/prowlarr_stats ;;
  */api/v1/request/count) f=media/overseerr_count ;;
  *//spoolman.test/api/v1/spool*) f=home/spoolman_spool ;;
  *//grafana.test/api/health) f=home/grafana_health ;;
  *//grafana.test/api/search*) f=home/grafana_search ;;
  *//grafana.test/api/alertmanager/*) f=home/grafana_alerts ;;
  *//glances.test/*quicklook) f=home/glances_quicklook ;;
  *//glances.test/*/load) f=home/glances_load ;;
  *//portainer.test/api/endpoints) f=home/portainer_endpoints ;;
  *//portainer.test/api/endpoints/3/docker/containers/json*) f=home/portainer_containers ;;
  *//truenas.test/api/v2.0/system/info) f=home/truenas_info ;;
  *//truenas.test/api/v2.0/pool) f=home/truenas_pool ;;
  *//truenas.test/api/v2.0/alert/list) f=home/truenas_alerts ;;
  *//kuma.test/empty/metrics) f=home/kuma_empty.txt ;;
  *//kuma.test/metrics) f=home/kuma_metrics.txt ;;
  *//moonraker.test/idle/printer/*) f=media/moonraker_idle ;;
  *//moonraker.test/printer/*) f=media/moonraker_printing ;;
  *//frigate.test:*/api/login) f=home/frigate_login ;;
  *//frigate.test:*/api/stats) f=home/frigate_stats ;;
  *//ha.test/api/) f=home/ha_api ;;
  *//ha.test/api/states/sensor.temp) f=home/ha_sensor_temp ;;
  *//ha.test/api/states/light.hall) f=home/ha_light_hall ;;
  *//ha.test/api/states/sensor.odd) f=home/ha_sensor_odd ;;
  *//jellyfin.test/Sessions*) f=media/jellyfin_sessions ;;
  *//jellyfin.test/evil/Items/Counts) f=media/jellyfin_counts_evil ;;
  *//jellyfin.test/Items/Counts) f=media/jellyfin_counts ;;
  */api/server/statistics) f=media/immich_stats ;;
  */rci/show/interface) f=rci/interface ;;
  */rci/show/ip/http/proxy) f=rci/proxy ;;
  */rci/) f=rci/system_name ;;
  */api/tunnels/all) f=awg/tunnels_all ;;
  */api/singbox/tunnels) f=awg/singbox_tunnels ;;
  *) exit 8 ;;
esac
# release dates relative to now, so the "next 7 days" filters have something to keep
case $f in *.txt) cat "$F/$f"; exit ;; esac
sed "s/@SOON@/$(date -u -d "@$(( $(date +%s) + 172800 ))" +%Y-%m-%dT%H:%M:%SZ)/" "$F/$f.json"
