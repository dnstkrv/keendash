#!/bin/sh
# keendash: remove older layouts, start the service, discover services
[ -x /opt/etc/init.d/S82uipatch ] && /opt/etc/init.d/S82uipatch stop >/dev/null 2>&1
rm -f /opt/etc/init.d/S82uipatch /opt/sbin/uipatch /opt/sbin/uistats /opt/sbin/uigeo /opt/sbin/uiservices \
  /opt/etc/cron.1min/uistats-collect /opt/etc/cron.1min/uigeo-refresh /opt/etc/cron.5mins/uiservices-discover
# up to 1.0.14: lighttpd copy, its config and log (opkg itself removes the old cron jobs and status.cgi)
killall keendash-httpd >/dev/null 2>&1
rm -rf /opt/sbin/keendash-httpd /opt/var/run/keendash.conf /opt/var/run/keendash.pid /opt/var/log/keendash
# 1.2.0-1.2.2: HTTPS on its own port (the new S81keendash doesn't close it, opkg removes the firewall hook) and its setting
p=$(cat /tmp/keendash/tls/port 2>/dev/null)
if [ -n "$p" ]; then
  PATH=/opt/sbin:/opt/bin:$PATH
  while iptables -w -D INPUT -p tcp --dport "$p" -m comment --comment keendash -j ACCEPT 2>/dev/null; do :; done
  while iptables -w -D INPUT -p tcp --dport "$p" -j ACCEPT 2>/dev/null; do :; done
fi
rm -rf /tmp/keendash/tls
c=/opt/etc/keendash/keendash.conf
[ -f "$c" ] && grep -q '^HTTPS_PORT=' "$c" && sed -i -e '/^# HTTPS for the web UI opened via KeenDNS/d' -e "/^# port with the router's own KeenDNS certificate/d" \
  -e '/^# firewall, also from the internet. Needs direct KeenDNS/d' -e '/^# http only; to turn it on e.g. HTTPS_PORT=/d' -e '/^HTTPS_PORT=/d' "$c" &&
  sed -i '/^$/N;/^\n$/D' "$c"
# 1.2.x: third-party service keys of keendash.conf -> services/<type>.conf
/opt/share/keendash/bin/settings migrate >/dev/null 2>&1
# smartmontools for the System card, only if a disk (not a flash stick) is attached; detached: opkg holds its lock while this runs
PATH=/opt/sbin:/opt/bin:$PATH
if ! command -v smartctl >/dev/null 2>&1; then
  dk=$(/opt/share/keendash/bin/smart disks | tr '\n' ' ')
  if [ -n "$dk" ]; then
    mkdir -p /tmp/keendash
    # a stalled feed must not keep the opkg lock for hours (as in bin/update); 5 minutes of tries while the parent opkg
    # and keendashd's first update check hold it; then the first reading at once, not at the next tick 5
    printf 'timeout = 20\ntries = 2\n' > /tmp/keendash/wgetrc
    WGETRC=/tmp/keendash/wgetrc nohup sh -c 'i=0; while [ $i -lt 60 ]; do opkg install smartmontools && exec /opt/share/keendash/bin/smart now; i=$((i+1)); sleep 5; done' > /tmp/keendash/smart-install.log 2>&1 </dev/null &
    echo "keendash: installing smartmontools in the background for the disk(s): $dk"
  fi
fi
# keendashd finds the services itself right at its start (bin/tick 5)
/opt/etc/init.d/S81keendash restart >/dev/null 2>&1
echo "keendash installed. Reload the Keenetic web UI main page (Ctrl+F5). Settings: /opt/etc/keendash/keendash.conf"
exit 0
