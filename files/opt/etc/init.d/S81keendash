#!/bin/sh
# keendash: dashboard card for the Keenetic web UI. One service that
#  1) runs keendashd: the web server for the widgets (status JSON, CGI, widget scripts) on the LAN address,
#     which also runs the periodic jobs (bin/tick); with the router's KeenDNS certificate (read by keendashd) also HTTPS
#     on HTTPS_PORT, opened in the firewall (/opt/etc/ndm/netfilter.d/80-keendash.sh), for the web UI via KeenDNS, and
#  2) bind-mounts the Keenetic index.html with the widget loader (bin/patch).
# All settings: /opt/etc/keendash/keendash.conf
#
# The process is found by its name, not by a pid file: /opt survives reboots, so a pid file left
# from the previous boot may point at an unrelated process.

PATH=/opt/sbin:/opt/bin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin
BIN=/opt/share/keendash/bin/keendashd
NAME=keendashd
ENVF=/opt/etc/keendash/keendash.conf
PATCH=/opt/share/keendash/bin/patch
WWW=/opt/share/keendash/www
FW=/opt/etc/ndm/netfilter.d/80-keendash.sh
TLS=/tmp/keendash/tls

LAN_IFACE="br0"; LAN_IP=""; PORT=8189; HTTPS_PORT=0
[ -f "$ENVF" ] && . "$ENVF"

pids() { pidof "$NAME" 2>/dev/null; }
is_running() { [ -n "$(pids)" ]; }

iface_ip() {
    r=$(ip -4 addr show dev "$1" 2>/dev/null | awk '$1 == "inet" { sub(/\/.*/, "", $2); print $2; exit }')
    [ -n "$r" ] || r=$(ifconfig "$1" 2>/dev/null | awk '/inet / { for (k = 1; k <= NF; k++) if ($k ~ /^(addr:)?[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) { sub(/^addr:/, "", $k); print $k; exit } }')
    echo "$r"
}

detect_ip() {
    if [ -n "$LAN_IP" ]; then echo "$LAN_IP"; return; fi
    for ifc in $LAN_IFACE; do
        r=$(iface_ip "$ifc")
        if [ -n "$r" ]; then echo "$r"; return; fi
    done
}

start() {
    if is_running; then echo "keendash already running"; return 0; fi

    # the server binds to the LAN address: wait (max ~30 s) until it is configured
    ip=""; n=0
    while :; do
        ip=$(detect_ip); [ -n "$ip" ] && break
        n=$((n + 1))
        if [ "$n" -gt 15 ]; then
            echo "keendash: no LAN address found; set LAN_IFACE or LAN_IP in $ENVF"
            return 1
        fi
        sleep 2
    done

    # keendashd goes to the background once the ports are bound and prints its pid, with HTTPS also the KeenDNS name;
    # a busy port fails here. HTTPS without the KeenDNS certificate or with a busy port: start again with HTTP only
    tls=""; [ "${HTTPS_PORT:-0}" != 0 ] && tls=$HTTPS_PORT
    # shellcheck disable=SC2086
    if out=$("$BIN" serve "$ip" "$PORT" "$WWW" $tls) || { [ -n "$tls" ] && tls="" && "$BIN" serve "$ip" "$PORT" "$WWW" >/dev/null; }; then
        # no addresses here: keendash's own ports serve only the card's data, users opened them and got lost
        echo "keendash started"
        if [ -n "$tls" ]; then
            mkdir -p "$TLS"; echo "$out" | sed -n 2p > "$TLS/fqdn"; echo "$HTTPS_PORT" > "$TLS/port"
            type=iptables table=filter "$FW"
        else
            rm -rf "$TLS"
        fi
        "$PATCH" stop >/dev/null 2>&1
        p=$("$PATCH" start); [ "$p" = "смонтировано" ] || echo "$p"
    else
        echo "keendash: failed to start on $ip:$PORT (port busy?)"
        return 1
    fi
}

stop() {
    "$PATCH" stop >/dev/null 2>&1
    # close the HTTPS port
    p=$(cat "$TLS/port" 2>/dev/null)
    if [ -n "$p" ]; then
        while iptables -w -D INPUT -p tcp --dport "$p" -m comment --comment keendash -j ACCEPT 2>/dev/null; do :; done
        while iptables -w -D INPUT -p tcp --dport "$p" -j ACCEPT 2>/dev/null; do :; done
    fi
    rm -rf "$TLS"
    if is_running; then
        killall "$NAME" 2>/dev/null
        n=0; while is_running && [ "$n" -lt 10 ]; do sleep 1; n=$((n + 1)); done
        is_running && killall -9 "$NAME" 2>/dev/null
        echo "keendash stopped"
    else
        echo "keendash is not running"
    fi
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart|reload|force-reload) stop; start ;;
    status)  if is_running; then echo "keendash running (pid $(pids))"; else echo "keendash stopped"; exit 1; fi ;;
    check)   is_running && echo alive || echo dead ;;
    *)       echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
