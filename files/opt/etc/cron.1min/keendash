#!/bin/sh
# keendash: every minute - metrics sample (ring buffers in /tmp/keendash, ~3 h of history), third-party services, country lookups
PATH=/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin
BIN=/opt/share/keendash/bin
D=/tmp/keendash; mkdir -p "$D"
$BIN/stats | while read -r k v; do
  case "$k" in
    telemt_conn|telemt_octets|awg_bytes|awg_up|firc_domains|ascn_ips|ascn_honeypot|nfq_pkts|nfq_auto|hr_ips|qb_dl|qb_up|sys_load|sys_mem|sys_temp)
      f="$D/$k"; { tail -n 179 "$f" 2>/dev/null; echo "$v"; } > "$f.t" && mv "$f.t" "$f";;
  esac
done
$BIN/ext
$BIN/geo --refresh
