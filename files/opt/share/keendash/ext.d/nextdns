#!/bin/sh
# name: NextDNS
# group: Сеть
# fields: user key
# hint: В «Логин» — ID профиля (Setup, 6 символов), API-ключ — внизу страницы Account
# NextDNS cloud API: queries and blocked share for the last day. USER (the profile ID) is a path segment: only [A-Za-z0-9]{1,32} goes to a request. URL (tests only, not a field) replaces the API host
BIN=${0%/*}/../bin; . "$BIN/extlib"
case "${USER:-}" in "" | *[!A-Za-z0-9]*) echo "ok 0"; exit ;; esac
[ ${#USER} -le 32 ] || { echo "ok 0"; exit; }
B=${URL:-https://api.nextdns.io}; B=${B%/}
J --header "X-Api-Key: ${KEY:-}" "$B/profiles/$USER/analytics/status?from=-1d" | awk "$LOAD"'END {
  if (V["data.0.status"] == "") { print "ok 0"; exit }
  for (i = 0; V["data." i ".status"] != ""; i++) { q = V["data." i ".queries"] + 0; t += q; if (V["data." i ".status"] == "blocked") b += q }
  print "ok 1"; print "t|Запросов за сутки|" t "|n"; print "t|Заблокировано|" b "|n"
  printf "t|Блокировок|%.1f|p\n", t ? b * 100 / t : 0 }'
