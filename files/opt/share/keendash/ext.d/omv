#!/bin/sh
# name: OpenMediaVault
# group: Серверы
# fields: url user pass
# probe: 80,https:443 / openmediavault
# hint: Администратор веб-интерфейса OMV (роль administrator)
# OpenMediaVault: uptime, load, memory over JSON-RPC; the login goes in a JSON body, its session cookie into the next request
BIN=${0%/*}/../bin; . "$BIN/extlib"
B=${URL%/}
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
sid=$(dl -S -O /dev/null --header 'Content-Type: application/json' --post-data "{\"service\":\"Session\",\"method\":\"login\",\"params\":{\"username\":\"$(esc "${USER:-}")\",\"password\":\"$(esc "${PASS:-}")\"}}" "$B/rpc.php" 2>&1 |
  sed -n 's/.*[Ss]et-[Cc]ookie: *\(X-OPENMEDIAVAULT-SESSIONID=[^;[:space:]]*\).*/\1/p' | tail -n 1)
J --header 'Content-Type: application/json' --header "Cookie: $sid" --post-data '{"service":"System","method":"getInformation","params":{}}' "$B/rpc.php" | awk "$LOAD"'
# uptime: seconds, or text like "1 day 2 hours 3 minutes 4 seconds" / "2 days, 03:04:05"
function up(u,  s, i, a) {
  if (u ~ /^[0-9.]+$/) return int(u)
  split("day hour min sec", a, " "); split("86400 3600 60 1", m, " ")
  for (i = 1; i <= 4; i++) if (match(u, "[0-9]+ " a[i])) s += substr(u, RSTART) * m[i]
  if (match(u, /[0-9]+:[0-9]+:[0-9]+/)) { split(substr(u, RSTART, RLENGTH), a, ":"); s += a[1] * 3600 + a[2] * 60 + a[3] }
  return s
}
END {
  if (!("response.uptime" in V)) { print "ok 0"; exit }
  l = V["response.loadAverage.1min"]; if (l == "") l = V["response.loadAverage.0"]; if (l == "") l = V["response.load.1min"]; if (l == "") l = V["response.load.0"]; if (l == "") l = V["response.load"]; if (l == "") l = V["response.loadAverage"]
  print "ok 1"; print "t|Работает|" up(V["response.uptime"]) "|s"; printf "t|Нагрузка|%.2f|t\n", l + 0
  print "t|Память|" (V["response.memTotal"] > 0 ? int(V["response.memUsed"] * 100 / V["response.memTotal"]) : "") "|p" }'
