#!/bin/sh
# name: Proxmox
# group: Серверы
# fields: url user key
# probe: https:8006 / Proxmox Virtual Environment
# hint: Логин: ID токена (root@pam!keendash), API-ключ: секрет токена; роль PVEAuditor. Сертификат не проверяется
# Proxmox VE: nodes online, running VMs and containers, mean node CPU; API token, certificate not checked (usually self-signed)
BIN=${0%/*}/../bin; . "$BIN/extlib"
B=${URL%/}
J --no-check-certificate --header "Authorization: PVEAPIToken=${USER:-}=${KEY:-}" "$B/api2/json/cluster/resources" | awk "$LOAD"'END {
  for (k in V) if (k ~ /^data\.[0-9]+\.type$/) {
    i = substr(k, 6, length(k) - 10); t = V[k]; s = V["data." i ".status"]
    if (V["data." i ".template"] == 1) continue
    if (t == "node") { n++; if (s == "online") o++; if (("data." i ".cpu") in V) { c += V["data." i ".cpu"]; cn++ } }
    else if (t == "qemu") { q++; if (s == "running") qr++ }
    else if (t == "lxc") { l++; if (s == "running") lr++ }
  }
  if (!n) { print "ok 0"; exit }
  print "ok 1"; print "t|Узлов в сети|" o + 0 " из " n "|t"; print "t|ВМ|" qr + 0 " из " q + 0 "|t"; print "t|LXC|" lr + 0 " из " l + 0 "|t"
  print "t|CPU|" (cn ? int(c * 100 / cn) : 0) "|p" }'
