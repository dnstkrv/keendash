#!/bin/sh
# name: Traefik
# group: Сеть
# fields: url user pass
# probe: 8080 /api/version "Codename"
# hint: Адрес API (api.insecure, порт 8080, или роутер на api@internal); логин — если стоит basicAuth
# Traefik /api/overview: totals over http, tcp, udp (warnings and errors cover routers, services and middlewares); Basic auth only when a login is set
BIN=${0%/*}/../bin; . "$BIN/extlib"
[ -z "${USER:-}" ] || set -- --header "Authorization: Basic $(printf '%s:%s' "$USER" "${PASS:-}" | base64 | tr -d '\n')"
J "$@" "${URL%/}/api/overview" | awk "$LOAD"'END {
  if (!("http.routers.total" in V)) { print "ok 0"; exit }
  n = split("http tcp udp", P, " "); m = split("routers services middlewares", K, " ")
  for (i = 1; i <= n; i++) for (j = 1; j <= m; j++) { p = P[i] "." K[j] "."
    if (j == 1) r += V[p "total"]; if (j == 2) s += V[p "total"]
    w += V[p "warnings"]; e += V[p "errors"] }
  print "ok 1"; print "t|Роутеров|" int(r) "|n"; print "t|Сервисов|" int(s) "|n"; print "t|Предупреждений|" int(w) "|n"; print "t|Ошибок|" int(e) "|n" }'
