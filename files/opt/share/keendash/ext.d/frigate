#!/bin/sh
# name: Frigate
# group: Дом
# fields: url user pass snap
# probe: 5000,https:8971 / Frigate
# hint: Адрес https://хост:8971 и логин Frigate либо http://хост:5000 без логина. Сертификат не проверяется. Кадры — при входе в роутер по https, живой поток — по http в домашней сети
# Frigate NVR (certificate not checked, 8971 is usually self-signed): version, detector speed, cameras (fps 0 = no stream), storage; the login (only with USER) goes in a JSON body, its cookie into the stats request.
# SNAP=1, 5, 15, 30 or 60 (1 is the old "yes" = 60): a frame of every camera (up to 8) into $PUB/cam/<ID>-<n>.jpg, n = place in the sorted list; $PUB is tmpfs, the web UI serves it only to a logged-in user.
# The minute run also writes the camera list $TMP/.cams.<ID> ("<n> <name>") and, for SNAP 5/15/30, the login cookie $TMP/.ck.<ID> (mode 600). With KEENDASH_FRAMES=1 (bin/snap, every SNAP seconds) only the frames
# of that list are fetched, with the saved cookie; KEENDASH_SNAP_END (epoch seconds) is the deadline after which no request starts.
BIN=${0%/*}/../bin; . "$BIN/extlib"
B=${URL%/}; set -- --no-check-certificate
PUB=${KEENDASH_PUB:-/tmp/mnt/.keendash}; C=$PUB/cam; T=${KEENDASH_TMP:-/tmp/keendash}
case "${ID:-}" in ""|*[!a-z0-9-]*) id= ;; *) id=$ID ;; esac
case "${SNAP:-}" in 1|5|15|30|60) sn=1 ;; *) sn= ;; esac
ck=$T/.ck.$id cm=$T/.cams.$id sid=
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
login() {
  sid=$(dl -S -O /dev/null --no-check-certificate --header 'Content-Type: application/json' --post-data "{\"user\":\"$(esc "$USER")\",\"password\":\"$(esc "${PASS:-}")\"}" "$B/api/login" </dev/null 2>&1 |
    sed -n 's/.*[Ss]et-[Cc]ookie: *\(frigate_token=[^;[:space:]]*\).*/\1/p' | head -n 1)
  # kept for bin/snap; written even when the login failed, so that it is not repeated every second
  case "${SNAP:-}" in 5|15|30) [ -z "$id" ] || (umask 077; mkdir -p "$T" && echo "$sid" > "$ck.t" && mv -f "$ck.t" "$ck") ;; esac
}
left() { [ -z "${KEENDASH_SNAP_END:-}" ] || [ $(( $(date +%s) + $1 )) -lt "$KEENDASH_SNAP_END" ]; }
if [ -n "${KEENDASH_FRAMES:-}" ]; then
  [ -n "$id" ] && [ -n "$sn" ] && [ -f "$cm" ] || exit 0
  if [ -z "${USER:-}" ]; then :; elif [ -f "$ck" ]; then sid=$(cat "$ck"); else login; fi
  out=
else
  [ -z "${USER:-}" ] || { login; set -- "$@" --header "Cookie: $sid"; }
  out=$(J "$@" "$B/api/stats" | awk "$LOAD"'END {
  for (k in V) {
    if (match(k, /^cameras\..+\.camera_fps$/)) C[substr(k, 9, RLENGTH - 19)] = 1
    else if (match(k, /^detectors\..+\.inference_speed$/)) { d = substr(k, 11, RLENGTH - 26); if (dn == "" || d < dn) dn = d }
    else if (k ~ /^service\.storage\..+\.used$/) { u += V[k]; su = 1 }
    else if (k ~ /^service\.storage\..+\.total$/) t += V[k]
  }
  for (c in C) { n++; N[n] = c }
  if (!n) { print "ok 0"; exit }
  print "ok 1"
  if (V["service.version"] != "") print "ver " V["service.version"]
  if (dn != "") { printf "inf %.1f\n", V["detectors." dn ".inference_speed"]; print "det " dn }
  for (i = 2; i <= n; i++) { x = N[i]; for (j = i - 1; j > 0 && N[j] > x; j--) N[j + 1] = N[j]; N[j + 1] = x }
  for (i = 1; i <= n; i++) {
    c = N[i]; f = V["cameras." c ".camera_fps"] + 0; s = c; gsub(/[[:cntrl:]|]/, " ", s)
    print "cam|" s "|" f "|" V["cameras." c ".detection_fps"] + 0 "|" (f == 0 ? 1 : 0)
    if (ENVIRON["SNAP"] ~ /^(1|5|15|30|60)$/ && i <= 8 && length(c) <= 64 && c ~ /^[A-Za-z0-9_-]+$/) print "frame " i ":" c
  }
  if (su) printf "used %.0f\ntotal %.0f\n", u * 1048576, t * 1048576 }')
  printf '%s\n' "$out" | sed '/^frame /d'
fi
# frames: only into $PUB/cam (never under /opt or the http www, they have no login); a camera's name is data and never part of a file name
if [ -n "$id" ] && [ -d "$PUB" ]; then
  have=" "
  if [ -n "$sn" ] && mkdir -p "$C" "$T"; then
    [ -n "${KEENDASH_FRAMES:-}" ] || { printf '%s\n' "$out" | sed -n 's/^frame \([0-9]*\):\(.*\)/\1 \2/p' > "$cm.t" && mv -f "$cm.t" "$cm"; }
    # the server is not trusted (no certificate check): at most 1 MB (one byte more shows it was cut), a JPEG signature, in RAM outside $PUB until then
    get() { dl -qO- --no-check-certificate ${sid:+--header "Cookie: $sid"} "$B/api/$name/latest.jpg?h=240" </dev/null 2>/dev/null | head -c 1048577 > "$t"; }
    while read -r i name; do
      case "$i" in [1-8]) ;; *) continue ;; esac
      case "$name" in ""|*[!A-Za-z0-9_-]*) continue ;; esac
      left 0 || break
      have="$have$i "; t=$T/.snap.$id-$i.$$
      get
      # a refused fetch in bin/snap: log in again, but not within 30 s of the last login (Frigate limits logins) nor close to the deadline
      if [ ! -s "$t" ] && [ -n "${KEENDASH_FRAMES:-}" ] && [ -n "${USER:-}" ] && left 3 && [ $(( $(date +%s) - $(date -r "$ck" +%s 2>/dev/null || echo 0) )) -ge 30 ]; then login; get; fi
      # An empty, failed, cut or not JPEG answer keeps the previous frame; mv is a rename that replaces whatever stands at the target
      if [ -s "$t" ] && [ "$(wc -c < "$t")" -le 1048576 ] && [ "$(head -c 2 "$t" | od -b | sed -n '1s/^[0-9]* *//p')" = "377 330" ]; then mv -f "$t" "$C/$id-$i.jpg"; else rm -f "$t"; fi
    done < "$cm"
  else
    rm -f "$cm" "$ck"
  fi
  if [ -z "${KEENDASH_FRAMES:-}" ]; then
    # frames of cameras that are gone, skipped (a name the loop refused) or not asked for
    rm -f "$C/.$id"-[0-9].jpg.t
    for f in "$C/$id"-[0-9].jpg; do
      [ -f "$f" ] || continue
      k=${f%.jpg}; k=${k##*-}
      case "$have" in *" $k "*) ;; *) rm -f "$f" ;; esac
    done
    # snap <time of the newest frame>: the card's cache key, it moves only when a frame does
    new=
    for k in $have; do [ -f "$C/$id-$k.jpg" ] && { m=$(date -r "$C/$id-$k.jpg" +%s) && [ "${m:-0}" -gt "${new:-0}" ] && new=$m; }; done
    [ -z "$new" ] || echo "snap $new"
  fi
fi
