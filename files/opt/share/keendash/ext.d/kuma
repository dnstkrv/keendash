#!/bin/sh
# name: Uptime Kuma
# group: Серверы
# fields: url key
# hint: Ключ: Settings → API Keys
# Uptime Kuma: monitors from /metrics (Prometheus text, parsed here; names are user text), failed first, 20 rows.
# History per monitor like ext.d/check: <tmp>/chk.<ID>.<key> (key = the name with all but [A-Za-z0-9.-] turned into _, _2, _3 ... on a
# collision), lines "<epoch> <status 0-3>" of the last 24 h; the row gets the percent of up among up/down and the last 30 statuses
# (comma separated: keendashd would turn "0011" into a number). Without a valid ID no history is kept and the row stays short
BIN=${0%/*}/../bin; . "$BIN/extlib"
T=${KEENDASH_TMP:-/tmp/keendash} NOW=${KEENDASH_NOW:-$(date +%s)}
case "${ID:-}" in ""|*[!a-z0-9-]*) ID= ;; esac
export T NOW ID
dl -qO- --header "Authorization: Basic $(printf ':%s' "${KEY:-}" | base64 | tr -d '\n')" "${URL%/}/metrics" 2>/dev/null | awk '
BEGIN { T = ENVIRON["T"]; NOW = ENVIRON["NOW"] + 0; ID = ENVIRON["ID"] }
# label value after monitor_name=": \ -> \, \" -> ", \n -> space; the | of the list line and control characters -> space
function nm(s,  i, c, d, o) {
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    if (c == "\"") break
    if (c == "\\") { d = substr(s, ++i, 1); c = (d == "n" ? " " : d) }
    o = o c
  }
  gsub(/[[:cntrl:]|]/, " ", o); return o
}
# merge the status into the monitor file (24 h, atomic through a temp file), set P[i] and H[i]
function hist(i,  k, b, f, t, m, p, u, d, j, s) {
  k = N[i]; gsub(/[^A-Za-z0-9.-]/, "_", k); k = substr(k, 1, 120)
  b = k; for (j = 2; k in K; j++) k = b "_" j
  K[k] = 1; f = T "/chk." ID "." k; t = T "/.chk." ID "." k ".t"
  while ((getline ln < f) > 0) { split(ln, p, " "); if (p[1] + 0 > NOW - 86400 && p[2] ~ /^[0-3]$/) { m++; E[m] = p[1]; L[m] = p[2] + 0 } }
  close(f)
  m++; E[m] = NOW; L[m] = S[i]
  for (j = 1; j <= m; j++) {
    print E[j], L[j] > t
    if (L[j] <= 1) d++; if (L[j] == 1) u++
    if (j > m - 30) s = s (s == "" ? "" : ",") L[j]
  }
  close(t); system("mv \"$T/.chk.$ID." k ".t\" \"$T/chk.$ID." k "\"")
  H[i] = s; j = int(u * 1000 / (d ? d : 1)); P[i] = d ? (j % 10 ? int(j / 10) "." j % 10 : j / 10) : ""
}
function rk(i) { return S[i] == 0 ? 0 : S[i] == 2 ? 1 : S[i] == 3 ? 2 : 3 }
{ sub(/\r$/, "") }
/^monitor_(status|response_time)\{monitor_name="/ {
  v = $NF; if (v !~ /^-?[0-9]+([.][0-9]+)?$/) next
  n = nm(substr($0, index($0, "=\"") + 2)); v += 0
  if ($0 ~ /^monitor_status/) { if (v >= 0 && v <= 3) { c++; N[c] = n; S[c] = int(v) } }
  else R[n] = v < 0 ? 0 : int(v)
}
END {
  if (!c) { print "ok 0"; exit }
  for (i = 1; i <= c; i++) {
    if (S[i] == 1) u++; else if (S[i] == 0) d++
    for (j = i - 1; j > 0 && (rk(O[j]) > rk(i) || (rk(O[j]) == rk(i) && N[O[j]] > N[i])); j--) O[j + 1] = O[j]
    O[j + 1] = i
  }
  if (ID != "") {
    for (i = 1; i <= c; i++) hist(i)
    # monitors that left the list lose their file
    while (("ls -a \"$T\" 2>/dev/null" | getline f) > 0)
      if (index(f, "chk." ID ".") == 1 && f ~ /^[A-Za-z0-9._-]+$/ && !(substr(f, length(ID) + 6) in K)) system("rm -f \"$T/" f "\"")
  }
  print "ok 1"; print "up " u + 0; print "down " d + 0
  for (i = 1; i <= c && i <= 20; i++) print "list|" N[O[i]] "|" S[O[i]] "|" R[N[O[i]]] + 0 (ID != "" ? "|" P[O[i]] "|" H[O[i]] : "")
  print "n " c }'
