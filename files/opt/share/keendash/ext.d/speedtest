#!/bin/sh
# name: Speedtest Tracker
# group: Сеть
# fields: url token
# probe: 80,8080 /api/healthcheck Speedtest Tracker is running
# hint: Токен: Settings → API Tokens, право results:read
# Speedtest Tracker: the latest result. *_bits is bit/s; without it download/upload are bytes/s. created_at is ISO 8601: Z or no offset = UTC
BIN=${0%/*}/../bin; . "$BIN/extlib"
U=${URL:-}; U=${U%/}
J --header "Authorization: Bearer ${TOKEN:-}" "$U/api/v1/results/latest" | awk -v now="${KEENDASH_NOW:-$(date +%s)}" "$LOAD"'
# a JSON null (a failed test) is flattened as the word null: no value, not 0
function g(k) { return V["data." k] == "null" ? "" : V["data." k] }
function bits(k) { if (g(k "_bits") != "") return g(k "_bits") * 1; return g(k) != "" ? g(k) * 8 : "" }
END {
  if (!("data.created_at" in V) && !("data.ping" in V) && !("data.download" in V) && !("data.download_bits" in V)) { print "ok 0"; exit }
  s = V["data.created_at"]; r = substr(s, 20); sub(/^\.[0-9]+/, "", r); o = 0
  if (r ~ /^[+-][0-9][0-9]:?[0-9][0-9]$/) { o = substr(r, 2, 2) * 3600 + substr(r, length(r) - 1) * 60; if (r ~ /^-/) o = -o }
  d = bits("download"); u = bits("upload"); a = s == "" ? "" : now - (ep(s) - o); if (a != "" && a < 0) a = 0
  print "ok 1"
  printf "t|Загрузка|%s|bit\n", d == "" ? "" : sprintf("%.0f", d)
  printf "t|Отдача|%s|bit\n", u == "" ? "" : sprintf("%.0f", u)
  printf "t|Пинг|%s|\n", g("ping") == "" ? "" : sprintf("%.0f", g("ping")) " мс"
  print "t|С последнего замера|" a "|s" }'
