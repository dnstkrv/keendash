#!/bin/sh
# LAN scan for the settings dialog, started by "settings apply" on a "scan" line: asks the router's active clients and the router
# itself (private IPv4 only) for the fingerprints of the service types (ext.d/<type>: "# probe: <ports> <path> <match>").
# Anonymous GETs only, nothing from the browser. Result in $TMP/scan: "state|run|<devices checked>|<devices>|<start>"
# (then "state|done|...|<end>"), "found|<ip>|<name>|<type>|<url>". One run at a time ($TMP/scan.lock holds its pid).
BIN=${0%/*}; . "$BIN/extlib"
ETC=${KEENDASH_ETC:-/opt/etc/keendash}
TMP=${KEENDASH_TMP:-/tmp/keendash}
EXTD=${KEENDASH_EXTD:-/opt/share/keendash/ext.d}
# the whole scan stops between batches after LIMIT seconds; a probe is cut by dl after DLT
LIMIT=${KEENDASH_SCAN_LIMIT:-180} DLT=2 LC_ALL=C
export DLT LC_ALL
T=$(printf '\t')
L=$TMP/scan.lock W=$TMP/scan.d n=0 of=0
mkdir -p "$TMP" || exit 1
# shortcut: an empty lock (another run between create and write) counts as live; a pid reused by another process too, until the lock is older than LIMIT + 60 s
if ! (set -C; echo $$ > "$L") 2>/dev/null; then
  p=$(cat "$L" 2>/dev/null)
  if [ -z "$p" ] || { kill -0 "$p" 2>/dev/null && [ $(( $(date +%s) - $(date -r "$L" +%s 2>/dev/null || echo 0) )) -lt $((LIMIT + 60)) ]; }; then exit 0; fi
  # take a stale lock over: of several runs only one moves it, and only that one still finds the pid it read
  mv "$L" "$L.$$" 2>/dev/null || exit 0
  [ "$(cat "$L.$$")" = "$p" ] || { [ -e "$L" ] || mv "$L.$$" "$L"; rm -f "$L.$$"; exit 0; }
  rm -f "$L.$$"; (set -C; echo $$ > "$L") 2>/dev/null || exit 0
fi
res() { { echo "state|$1|$n|$of|$2"; cat "$W/found"; } > "$TMP/scan.new" && mv "$TMP/scan.new" "$TMP/scan"; }
trap 'res done "$(date +%s)"; rm -rf "$W" "$L"' EXIT
trap 'exit 1' HUP INT TERM
rm -rf "$W"; mkdir "$W" && : > "$W/found" || exit 1
t0=$(date +%s); res run "$t0"

# "<ip><TAB><name>": the router, then its active clients; the name is cleaned (no control characters or |, 64 characters)
RIP=$("$BIN/rci" show/interface/Bridge0 | awk -F'\t' '$1 == "address" { print $2; exit }')
"$BIN/rci" show/ip/hotspot | awk -v r="$RIP" 'function chars(s, k,  i, c, m) { m = length(s); for (i = 1; i <= m; i++) if (substr(s, i, 1) !~ cont && ++c > k) return substr(s, 1, i - 1); return s }
  function cl(s) { gsub(ctl, "", s); gsub(/[|]/, "", s); gsub(/^ +| +$/, "", s); return chars(s, 64) }
  function priv(s,  a, i) { if (s !~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) return 0; split(s, a, ".")
    for (i = 1; i <= 4; i++) if (a[i] !~ /^(0|[1-9][0-9]*)$/ || a[i] > 255) return 0
    return a[1] == 10 || (a[1] == 172 && a[2] >= 16 && a[2] <= 31) || (a[1] == 192 && a[2] == 168) }
  function emit(ip, nm) { if (ip in S || c >= 254) return; S[ip] = 1; c++; print ip "\t" nm }
  BEGIN { FS = "\t"; ctl = "[" sprintf("%c", 1) "-" sprintf("%c", 31) sprintf("%c", 127) "]"; cont = "[" sprintf("%c", 128) "-" sprintf("%c", 191) "]" }
  $1 ~ /^host\.[0-9]+\.(ip|active|name|hostname)$/ { split($1, a, "."); k = a[2] + 0; F[k, a[3]] = $2; if (k + 1 > m) m = k + 1 }
  END { if (priv(r)) emit(r, "Роутер")
    for (k = 0; k < m; k++) if (F[k, "active"] == "true" && priv(F[k, "ip"])) {
      nm = cl(F[k, "name"]); if (nm == "") nm = cl(F[k, "hostname"]); if (nm == "") nm = F[k, "ip"]; emit(F[k, "ip"], nm) } }' > "$W/dev"
of=$(( $(wc -l < "$W/dev") ))

# "<scheme:port><TAB><path><TAB><type><TAB><match>", rows of one port and path together
set -- "$EXTD"/*
[ -e "$1" ] || set -- /dev/null
awk 'FNR <= 20 && /^# probe: / { t = FILENAME; sub(/.*\//, "", t); s = substr($0, 10); sub(/\r$/, "", s)
    if (t !~ /^[a-z0-9-]+$/ || !match(s, /^[0-9a-z:,]+ \/[^ \t]* /) || (m = substr(s, RLENGTH + 1)) == "" || index(m, "\t")) next
    split(substr(s, 1, RLENGTH - 1), a, " "); k = split(a[1], pp, ",")
    for (i = 1; i <= k; i++) if (pp[i] ~ /^(https:)?[0-9]+$/) R[++n] = (pp[i] ~ /^https/ ? "" : "http:") pp[i] "\t" a[2] "\t" t "\t" m }
  END { for (i = 1; i <= n; i++) { split(R[i], f, "\t"); k = f[1] "\t" f[2]; if (k in D) continue; D[k] = 1
      for (j = i; j <= n; j++) { split(R[j], g, "\t"); if (g[1] "\t" g[2] == k) print R[j] } } }' "$@" > "$W/tab"
set -- $(awk -F'\t' '!s[$1]++ { print $1 }' "$W/tab")
P=$# SPS="$*"

# "<type> <host:port>" of the services already added (127.0.0.1 and localhost are the router)
for f in "$ETC"/services/*.conf; do
  [ -f "$f" ] || continue
  ( . "$f"; [ -n "${TYPE:-}" ] && [ -n "${URL:-}" ] || exit
    u=${URL#*://}; u=${u%%/*}; u=${u##*@}
    case $u in *:*) ;; *) u=$u:80; [ "${URL%%:*}" = https ] && u=${u%:80}:443 ;; esac
    case ${u%:*} in localhost|127.0.0.1) u=$RIP:${u##*:} ;; esac
    echo "$TYPE $u" )
done > "$W/have"

# one device and port: the first type whose match is in a response wins; $1 ip, $2 name, $3 scheme:port, $4 job number
# (a batch has 8 jobs, so 8 response files are enough)
probe() {
  f=$W/r$(( $4 % 8 )) sch=${3%%:*} port=${3#*:} lp= rc=0 x=
  [ "$sch" = https ] && x=--no-check-certificate
  while IFS=$T read -r s p t m; do
    [ "$s" = "$3" ] || continue
    if [ "$p" != "$lp" ]; then
      # a refused or timed out port has nothing on its other paths (141 is SIGPIPE from the 64 KB cut: an answer)
      case $rc in 141) ;; 4|1[2-9][0-9]|[2-9][0-9][0-9]) return ;; esac
      lp=$p
      # the first 64 KB of headers and body; no redirects, a client could send the router anywhere
      { dl -S -O- --tries=1 --max-redirect=0 $x "$sch://$1:$port$p" 2>&1; echo $? > "$f.rc"; } | head -c 65536 > "$f"
      rc=$(cat "$f.rc" 2>/dev/null); rc=${rc:-1}
    fi
    grep -qF -e "$m" "$f" || continue
    grep -qxF "$t $1:$port" "$W/have" || printf 'found|%s|%s|%s|%s://%s:%s\n' "$1" "$2" "$t" "$sch" "$1" "$port" >> "$W/found"
    return
  done < "$W/tab"
}

[ "$P" -gt 0 ] || { n=$of; exit 0; }
i=0 stop=
while IFS=$T read -r ip name; do
  for sp in $SPS; do
    probe "$ip" "$name" "$sp" $i &
    i=$((i + 1))
    if [ $((i % 8)) = 0 ]; then
      wait; n=$((i / P)); res run "$t0"
      [ $(( $(date +%s) - t0 )) -ge "$LIMIT" ] && { stop=1; break 2; }
    fi
  done
done < "$W/dev"
wait
[ -n "$stop" ] || n=$of
