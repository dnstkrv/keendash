#!/bin/sh
# Country codes for addresses banned by antiscan.
#   geo --refresh   look up (via ip-api.com, plain HTTP) top banned addresses missing in the cache; run from cron
# Cache: /opt/var/lib/keendash/geo.cache  (ip|CC).   Disable lookups: GEO=0 in /opt/etc/keendash/keendash.conf
PATH=/opt/sbin:/opt/bin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
CACHE=/opt/var/lib/keendash/geo.cache
[ "$1" = "--refresh" ] || { echo "usage: $0 --refresh"; exit 1; }
GEO=1; [ -f /opt/etc/keendash/keendash.conf ] && . /opt/etc/keendash/keendash.conf
[ "$GEO" = 1 ] || exit 0
# single instance (stale lock after 3 min)
if ! mkdir /tmp/keendash-geo.lock 2>/dev/null; then
  [ -n "$(find /tmp/keendash-geo.lock -mmin +3 2>/dev/null)" ] && rmdir /tmp/keendash-geo.lock 2>/dev/null
  exit 0
fi
trap "rmdir /tmp/keendash-geo.lock 2>/dev/null" EXIT
mkdir -p /opt/var/lib/keendash; touch "$CACHE"
fetch() { # url outfile (6 s limit)
  wget -qO "$2" "$1" 2>/dev/null &
  p=$!; i=0
  while [ $i -lt 6 ] && kill -0 $p 2>/dev/null; do sleep 1; i=$((i+1)); done
  kill $p 2>/dev/null
}
todo=""
for s in ips subnets honeypot; do
  for it in $(ipset list ascn_$s 2>/dev/null | tail -n +8 | awk '{t=0; for(i=1;i<=NF;i++) if($i=="timeout") t=$(i+1); print t, $1}' | sort -n -r | head -12 | awk '{print $2}'); do
    k=${it%%/*}
    grep -q "^$k|[A-Z][A-Z]$" "$CACHE" && continue
    case " $todo " in *" $k "*) continue;; esac
    todo="$todo $k"
  done
done
n=0
for k in $todo; do
  [ $n -ge 8 ] && break
  n=$((n+1))
  fetch "http://ip-api.com/line/$k?fields=countryCode" /tmp/keendash-geo.out
  cc=$(head -1 /tmp/keendash-geo.out 2>/dev/null | tr -cd 'A-Z')
  [ ${#cc} -eq 2 ] || { sleep 2; continue; }
  echo "$k|$cc" >> "$CACHE"
  sleep 2
done
rm -f /tmp/keendash-geo.out
[ "$(wc -l < "$CACHE")" -gt 600 ] && { tail -n 400 "$CACHE" > "$CACHE.t" && mv "$CACHE.t" "$CACHE"; }
exit 0
