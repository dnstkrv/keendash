#!/bin/sh
# Auto-discovers Entware services (/opt/etc/init.d/S*), their state and web UIs.
#   services             -> svc|name|state|link     (state: 1 up, 0 down, 2 disabled, 3 unknown; link = first web UI)
#                             web|name|port|title     (every web UI found for the service)
#   services --discover  -> probe listening ports of running services, refresh the cache (cron)
# Overrides: LINKS="..." in /opt/etc/keendash/keendash.conf  (name=8080 | name=http://host/path | name=- | name=hide)
PATH=/opt/sbin:/opt/bin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
INITD=/opt/etc/init.d
D=/tmp/keendash; CACHE=$D/links; CONF=$D/links.ov
LINKS=""; [ -f /opt/etc/keendash/keendash.conf ] && . /opt/etc/keendash/keendash.conf
HIDE_DEFAULT=" keendash "
mkdir -p "$D"; printf "%s\n" "$LINKS" > "$CONF"

# /proc, not ps: procps-ng ps from Entware lists only the caller's tty (nothing under CGI). comm is cut to 15 chars.
RUNS=$(cat /proc/[0-9]*/comm 2>/dev/null | sort -u)

scan() {
  for f in "$INITD"/S[0-9]*; do
    [ -f "$f" ] || continue
    name=$(basename "$f" | sed 's/^S[0-9]*//')
    [ -n "$name" ] || continue
    case "$HIDE_DEFAULT" in *" $name "*) continue;; esac
    en=$(sed -n 's/^ENABLED=//p' "$f" | head -1 | tr -d "\"' ")
    procs=$(sed -n 's/^PROCS\{0,1\}=//p' "$f" | head -1 | tr -d "\"'")
    names="$name"
    for w in $procs; do case "$w" in *'$'*) ;; *) names="$names ${w##*/}";; esac; done
    found=""
    for n in $names; do printf '%s\n' "$RUNS" | grep -qx -- "$(printf '%.15s' "$n")" && found="$found,$n"; done
    if [ -z "$found" ] && [ -z "$procs" ]; then
      p=$(printf '%s\n' "$RUNS" | awk -v n="$name" 'index($0,substr(n,1,15))==1{print; exit}')
      [ -n "$p" ] && found=",$p"
    fi
    if [ "$en" = no ]; then st=2
    elif [ -n "$found" ]; then st=1
    elif grep -qi 'antiscan\|ascn_' "$f" 2>/dev/null; then
      if ipset list -n 2>/dev/null | grep -q '^ascn_' && iptables -S ANTISCAN >/dev/null 2>&1; then st=1; else st=0; fi
    elif grep -qE 'pidof|killall|start-stop-daemon|rc\.func|PROCS' "$f"; then st=0
    else st=3; fi
    echo "$name|$st|${found#,}"
  done
}

discover() {
  NS=$(netstat -lntp 2>/dev/null | awk '$6=="LISTEN"{n=split($7,a,"/"); addr=$4; p=addr; sub(/^.*:/,"",p); h=addr; sub(/:[0-9]+$/,"",h); print a[2] "|" h "|" p}' | sort -u)
  rm -f "$D"/probe.*
  scan | while IFS='|' read -r name st procs; do
    [ -n "$procs" ] || continue
    for pr in $(printf '%s' "$procs" | tr ',' ' '); do
      printf '%s\n' "$NS" | awk -F'|' -v pr="$pr" 'substr($1,1,15)==substr(pr,1,15){print $2 "|" $3}'
    done | sort -u | while IFS='|' read -r h p; do
      case "$h" in
        127.*|::1) continue;;
        ::|0.0.0.0|'*'|'') a=127.0.0.1;;
        *:*) continue;;
        *) a=$h;;
      esac
      out="$D/probe.$name.$p"
      wget -S -O "$out.body" "http://$a:$p/" > "$out" 2>&1 &
      wp=$!
      ( sleep 5; kill $wp 2>/dev/null ) >/dev/null 2>&1 &
    done
  done
  sleep 6
  : > "$CACHE.tmp"
  for f in "$D"/probe.*; do
    [ -f "$f" ] || continue
    case "$f" in *.body) continue;; esac
    b=${f#$D/probe.}; name=${b%.*}; port=${b##*.}
    code=$(grep -oE 'HTTP/1\.[01] [0-9]+' "$f" | tail -1 | awk '{print $2}')
    case "$code" in
      200|301|302|307|308|401)
        title=$(head -c 8192 "$f.body" 2>/dev/null | tr '\r\n' '  ' | sed -n 's/.*<[Tt][Ii][Tt][Ll][Ee][^>]*>\([^<]*\)<\/[Tt][Ii][Tt][Ll][Ee]>.*/\1/p' | tr -d '|"\\' | cut -c1-40)
        echo "$name|$port|$title" >> "$CACHE.tmp";;
    esac
    rm -f "$f" "$f.body"
  done
  sort "$CACHE.tmp" > "$CACHE"; rm -f "$CACHE.tmp"
}

if [ "$1" = "--discover" ]; then discover; exit 0; fi
[ -f "$CACHE" ] || { discover >/dev/null 2>&1; }
scan | awk -F'|' -v cache="$CACHE" -v conf="$CONF" '
  BEGIN {
    while ((getline l < cache) > 0) {
      split(l, a, "|"); n = a[1]; p = a[2] + 0
      k = ++cnt[n]; WP[n, k] = a[2]; WT[n, k] = a[3]
      if (!(n in L) || p < L[n] + 0) L[n] = a[2]
    }
    while ((getline l < conf) > 0) {
      if (l ~ /^[ \t]*(#|$)/) continue
      i = index(l, "="); if (!i) continue
      k = substr(l, 1, i - 1); v = substr(l, i + 1); gsub(/[ \t\r]/, "", k); gsub(/[ \t\r]/, "", v); C[k] = v
    }
  }
  { n = $1; if ((n in C) && C[n] == "hide") next
    ov = (n in C)
    link = ov ? (C[n] == "-" ? "" : C[n]) : L[n]
    print "svc|" n "|" $2 "|" link
    if (!ov) {
      # list ports ascending
      m = cnt[n]
      for (i = 1; i <= m; i++) used[i] = 0
      for (c = 1; c <= m; c++) {
        best = 0
        for (i = 1; i <= m; i++) if (!used[i] && (!best || WP[n, i] + 0 < WP[n, best] + 0)) best = i
        used[best] = 1
        print "web|" n "|" WP[n, best] "|" WT[n, best]
      }
    }
  }'
