#!/bin/sh
# Settings from the web UI. The browser uploads a message to $VAR/inbox/<rev>.txt through the firmware's file manager
# (/rci/put + /fui), keendashd runs "settings apply" every 5 s while the inbox has files.
#   settings list    the settings for status.json (keendashd status): vol|, rev|, err|, type|, inst|, hide|, col| lines
#   settings apply   check and apply the inbox messages, oldest first; the last result goes to $TMP/settings.state
# A message is "keendash 1 <rev>", then add/set/del/hide/show/col lines, then "end". One bad line rejects all of it.
# Values from the browser are never run: services/<id>.conf has only KEY='value' lines, ids are [a-z0-9-].
PATH=/opt/sbin:/opt/bin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
ETC=${KEENDASH_ETC:-/opt/etc/keendash}
VAR=${KEENDASH_VAR:-/opt/var/lib/keendash}
TMP=${KEENDASH_TMP:-/tmp/keendash}
EXTD=${KEENDASH_EXTD:-/opt/share/keendash/ext.d}

# "type|<type>|<name>|<group>|<f1,f2>" from the collectors' headers: "# name: ...", "# group: ...", "# fields: url user pass"
types() {
  set -- "$EXTD"/*
  [ -e "$1" ] || return 0
  awk 'function out() { if (t ~ /^[a-z0-9-]+$/) print "type|" t "|" n "|" g "|" f }
    FNR == 1 { out(); t = FILENAME; sub(/.*\//, "", t); n = t; g = ""; f = "" }
    FNR <= 20 && /^# name: / { n = substr($0, 9) }
    FNR <= 20 && /^# group: / { g = substr($0, 10) }
    FNR <= 20 && /^# fields: / { f = ""; k = split(substr($0, 11), a, " "); for (i = 1; i <= k; i++) if (a[i] ~ /^(url|user|pass|key|token)$/) f = f (f == "" ? "" : ",") a[i] }
    END { out() }' "$@"
}

list() {
  [ -f "$TMP/vol" ] && echo "vol|$(cat "$TMP/vol")"
  [ -f "$TMP/settings.state" ] && sed -n 's/^rev /rev|/p; s/^err /err|/p' "$TMP/settings.state"
  types
  set -- "$ETC"/services/*.conf
  # a conf removed by apply in between must not abort awk
  for f; do [ -f "$f" ] && set -- "$@" "$f"; shift; done
  # secrets: only the names of the ones that are set
  [ -e "$1" ] && awk -v q="'" 'FNR == 1 { if (id != "") out(); id = FILENAME; sub(/.*\//, "", id); sub(/\.conf$/, "", id); split("", V) }
    match($0, /^[A-Z]+=/) && substr($0, RLENGTH + 1, 1) == q { v = substr($0, RLENGTH + 2); if (substr(v, length(v)) == q) v = substr(v, 1, length(v) - 1)
      gsub(q "\\\\" q q, q, v); V[substr($0, 1, RLENGTH - 1)] = v }
    function out(  s) { s = (V["PASS"] != "" ? ",pass" : "") (V["KEY"] != "" ? ",key" : "") (V["TOKEN"] != "" ? ",token" : "")
      print "inst|" id "|" V["TYPE"] "|" V["NAME"] "|" V["URL"] "|" V["USER"] "|" substr(s, 2) }
    END { if (id != "") out() }' "$@"
  [ -f "$ETC/ui.conf" ] && awk '$1 == "hide" && NF == 3 && ($2 == "page" || $2 == "main") { print "hide|" $2 "|" $3 }
    $1 == "col" { s = ""; for (i = 3; i <= NF; i++) s = s (i > 3 ? "," : "") $i; print "col|" s }' "$ETC/ui.conf"
  return 0
}

# check a message against the types, the instances and ui.conf; print "E <error>" or what to move into place:
# "M <id>" ($W/<id>.conf -> services), "R <id>" (remove), "U" ($W/ui.conf)
CHECK='function bad(r) { if (err == "") err = "строка " FNR ": " substr(r, 1, 120) }
function okid(s) { return s ~ /^[a-z0-9-]+$/ && length(s) <= 32 }
function okname(s) { return s ~ /^[A-Za-z0-9._-]+$/ && length(s) <= 64 }
function clr(id,  k, p) { for (k in V) { split(k, p, SUBSEP); if (p[1] == id) delete V[k] } }
function sq(v,  o, i) { o = ""; while ((i = index(v, q)) > 0) { o = o substr(v, 1, i - 1) q "\\" q q; v = substr(v, i + 1) } return q o v q }
function hides(w, o,  n, a, k, p, i, j, t) {
  n = 0; for (k in H) { split(k, p, SUBSEP); if (p[1] == w) a[++n] = p[2] }
  for (i = 2; i <= n; i++) { t = a[i]; for (j = i - 1; j > 0 && a[j] > t; j--) a[j + 1] = a[j]; a[j + 1] = t }
  for (i = 1; i <= n; i++) print "hide " w " " a[i] > o
}
BEGIN { ctl = "[" sprintf("%c", 1) "-" sprintf("%c", 31) sprintf("%c", 127) "]"; cont = "[" sprintf("%c", 128) "-" sprintf("%c", 191) "]" }
FILENAME == TY { split($0, a, "|"); FL[a[2]] = a[5]; F[a[2]] = " " a[5] " "; gsub(/,/, " ", F[a[2]]); next }
FILENAME == UI { if ($1 == "hide" && NF == 3) H[$2, $3] = 1; else if ($1 == "col") { s = $0; sub(/^col [0-9]* ?/, "", s); C[nc++] = s } next }
FILENAME != MSG { if (FNR == 1) { id = FILENAME; sub(/.*\//, "", id); sub(/\.conf$/, "", id); if (okid(id)) E[id] = 1 }
  if (okid(id) && match($0, /^[A-Z]+=/) && substr($0, RLENGTH + 1, 1) == q) { v = substr($0, RLENGTH + 2); if (substr(v, length(v)) == q) v = substr(v, 1, length(v) - 1)
    gsub(q "\\\\" q q, q, v); V[id, substr($0, 1, RLENGTH - 1)] = v }
  next }
FNR == 1 { if ($0 !~ /^keendash 1 [A-Za-z0-9]+$/) bad("неверная первая строка, нужна keendash 1 <метка>"); next }
err != "" || done || $0 == "" { next }
$0 == "end" { done = 1; next }
$1 == "add" { if (NF != 3 || !okid($2)) bad("неверный id"); else if (!($3 in F)) bad("неизвестный тип " $3); else if ($2 in E) bad($2 " уже есть")
  else { E[$2] = 1; X[$2] = 1; A[$2] = FNR; delete R[$2]; clr($2); V[$2, "TYPE"] = $3 } next }
$1 == "del" { if (NF != 2 || !($2 in E)) bad("нет сервиса " $2); else { delete E[$2]; delete X[$2]; delete A[$2]; R[$2] = 1; clr($2) } next }
$1 == "set" { s = substr($0, 5); id = s; sub(/ .*/, "", id); s = substr(s, length(id) + 2); f = s; sub(/ .*/, "", f); v = substr(s, length(f) + 2)
  c = v; gsub(cont, "", c)
  if (!(id in E)) bad("нет сервиса " id)
  else if (f != "name" && (f !~ /^[a-z]+$/ || !index(F[V[id, "TYPE"]], " " f " "))) bad("неизвестное поле " f)
  else if (length(v) > 512) bad("значение длиннее 512 байт")
  else if (v ~ ctl) bad("управляющий символ в значении")
  else if ((f == "name" || f == "url" || f == "user") && index(v, "|")) bad("символ | в поле " f)
  else if (f == "url" && v !~ /^https?:\/\//) bad("адрес должен начинаться с http:// или https://")
  else if (f == "name" && length(c) > 64) bad("имя длиннее 64 символов")
  else { V[id, toupper(f)] = v; X[id] = 1 }
  next }
$1 == "hide" || $1 == "show" { if (NF != 3 || ($2 != "page" && $2 != "main") || !okname($3)) bad("неверная строка " $1)
  else { if ($1 == "hide") H[$2, $3] = 1; else delete H[$2, $3]; ui = 1 } next }
$1 == "col" { if (NF < 2 || $2 !~ /^[0-5]$/) { bad("неверный номер колонки"); next }
  for (i = 3; i <= NF; i++) if (!okname($i)) { bad("неверный id карточки " $i); next }
  if (!newc) { newc = 1; split("", C) }
  s = ""; for (i = 3; i <= NF; i++) s = s (i > 3 ? " " : "") $i; C[$2] = s; ui = 1; next }
{ bad("неизвестная команда " $1) }
END {
  if (err == "") for (id in A) if (index(F[V[id, "TYPE"]], " url ") && V[id, "URL"] == "" && (m == "" || A[id] < m)) m = A[id]
  if (err == "" && m != "") err = "строка " m ": не задан адрес"
  if (err != "") { print "E " err; exit 1 }
  for (id in X) {
    o = W "/" id ".conf"; t = V[id, "TYPE"]
    print "TYPE=" sq(t) > o; print "NAME=" sq(V[id, "NAME"]) > o
    n = split(FL[t] != "" ? FL[t] : "url,user,pass,key,token", fl, ",")
    for (i = 1; i <= n; i++) if ((k = toupper(fl[i])) != "NAME" && V[id, k] != "") print k "=" sq(V[id, k]) > o
    close(o); print "M " id
  }
  for (id in R) print "R " id
  if (ui) {
    o = W "/ui.conf"; printf "" > o; hides("page", o); hides("main", o)
    k = 0; for (n = 0; n < 32; n++) if (n in C) print "col " (k++) (C[n] == "" ? "" : " " C[n]) > o
    close(o); print "U"
  }
}'

apply() {
  umask 077
  # the work dir is on the same filesystem as the config, so mv is an atomic rename
  IN=$VAR/inbox W=$ETC/.w
  mkdir -p "$ETC/services" "$TMP" "$IN" || return 1
  # shortcut: mtime has 1 s resolution, two drops within a second may apply out of order; upgrade: time-prefixed rev
  ls -tr "$IN" | while IFS= read -r n; do
    f=$IN/$n
    [ -f "$f" ] || { rm -rf "$f"; continue; }
    age=$(( $(date +%s) - $(date -r "$f" +%s) ))
    # still being uploaded
    [ $age -lt 2 ] && continue
    rev=$(printf %s "${n%.txt}" | tr -cd 'A-Za-z0-9' | cut -c1-16)
    if [ "$(wc -c < "$f")" -gt 65536 ]; then err="сообщение больше 64 КБ"
    elif [ "$(tr -d '\000' < "$f" | wc -c)" -ne "$(wc -c < "$f")" ]; then err="строка 0: байт NUL в сообщении"
    elif [ "$(tail -n 1 "$f")" != end ]; then
      [ $age -lt 30 ] && continue
      err="сообщение загружено не полностью"
    else
      rm -rf "$W"; mkdir "$W" || return 1
      types > "$W/types"
      set -- "$ETC"/services/*.conf
      [ -e "$1" ] || set --
      [ -f "$ETC/ui.conf" ] && set -- "$@" "$ETC/ui.conf"
      if out=$(LC_ALL=C awk -v q="'" -v W="$W" -v TY="$W/types" -v UI="$ETC/ui.conf" -v MSG="$f" "$CHECK" "$W/types" "$@" "$f"); then
        err=
        # the loop is a pipeline subshell: its exit status says whether every mv/rm worked
        printf '%s\n' "$out" | while read -r op id; do
          case $op in
            M) mv -f "$W/$id.conf" "$ETC/services/$id.conf" || exit 1 ;;
            R) rm -f "$ETC/services/$id.conf" || exit 1 ;;
            U) mv -f "$W/ui.conf" "$ETC/ui.conf" || exit 1 ;;
          esac
        done || err="не удалось записать настройки"
      else
        err=${out#E }
        [ "$err" = "$out" ] && err="не удалось проверить сообщение"
      fi
      rm -rf "$W"
    fi
    # shortcut: settings.state keeps only the last rev; two browsers in one apply run → the first times out though applied; upgrade: keep a short list of recent revs
    printf 'rev %s\nerr %s\n' "$rev" "$err" > "$TMP/settings.state"
    rm -f "$f"
  done
}

case $1 in
  list) list ;;
  apply) apply ;;
  *) echo "usage: settings list | apply" >&2; exit 2 ;;
esac
