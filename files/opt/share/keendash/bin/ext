#!/bin/sh
# Third-party services over their HTTP APIs: one collector per type in ext.d, one run per instance (etc/services/<id>.conf).
# Their APIs can be slow or down, so bin/tick runs this every minute in the background: each instance goes to
# /tmp/keendash/x/<id>, keendashd reads that cache. A collector gets ID (the instance) URL USER PASS KEY TOKEN MAP HOSTS EVERY SNAP in its environment and prints
# "key value" / "table|a|b" lines; "~key value" lines are also appended to s.<id>.<key> (graph history).
#   ext          refresh the cache for every instance
#   ext <id>     print one instance to stdout (debugging, tests)
PATH=/opt/sbin:/opt/bin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
ETC=${KEENDASH_ETC:-/opt/etc/keendash}
TMP=${KEENDASH_TMP:-/tmp/keendash}
EXTD=${KEENDASH_EXTD:-/opt/share/keendash/ext.d}
PUB=${KEENDASH_PUB:-/tmp/mnt/.keendash}

# run the collector of one instance; the conf is KEY='value' lines written by bin/settings, so sourcing it is safe
inst() {
  unset TYPE URL USER PASS KEY TOKEN MAP HOSTS EVERY SNAP
  . "$ETC/services/$1.conf"
  case "${TYPE:-}" in ""|*[!a-z0-9-]*) return 1 ;; esac
  [ -f "$EXTD/$TYPE" ] || return 1
  ID=$1; export ID URL USER PASS KEY TOKEN MAP HOSTS EVERY SNAP
  # 2>/dev/null: the shell reports a wget killed by its deadline as "Terminated"; || : keeps the cache when a collector exits non-zero
  sh "$EXTD/$TYPE" 2>/dev/null || :
}

# an instance with EVERY (minutes) is due when it has no cache, its conf is newer than the cache (just saved), or the cache
# is EVERY*60-30 s old (the tick is not aligned to the minute) or from the future (the clock was set back). KEENDASH_NOW (epoch seconds) is for the tests.
# Run in a subshell (it sources the conf); a bad EVERY counts as none
due() {
  unset EVERY
  . "$ETC/services/$1.conf"
  case "${EVERY:-}" in ""|*[!0-9]*|0*) return 0 ;; esac
  [ ! -f "$TMP/x/$1" ] || [ "$ETC/services/$1.conf" -nt "$TMP/x/$1" ] ||
    { a=$(( ${KEENDASH_NOW:-$(date +%s)} - $(date -r "$TMP/x/$1" +%s) )); [ "$a" -lt 0 ] || [ "$a" -ge $(( EVERY * 60 - 30 )) ]; }
}

# refresh one instance: x/<id> atomically, "~key value" lines into the history files (the last 180)
refresh() {
  due "$1" || return
  inst "$1" > "$TMP/x/$1.new" || { rm -f "$TMP/x/$1.new" "$TMP/x/$1"; return; }
  [ -s "$TMP/x/$1.new" ] || echo "ok 0" > "$TMP/x/$1.new"
  sed -n 's/^~\([a-z0-9_]*\) \(.*\)/\1 \2/p' "$TMP/x/$1.new" | while read -r k v; do
    f="$TMP/s.$1.$k"; { tail -n 179 "$f" 2>/dev/null; echo "$v"; } > "$TMP/.s.$1.$k.t" && mv "$TMP/.s.$1.$k.t" "$f"
  done
  mv "$TMP/x/$1.new" "$TMP/x/$1"
}

case "${1:-}" in
  "") ;;
  *[!a-z0-9-]*) echo "usage: ext [<service id>]" >&2; exit 2 ;;
  *) [ -f "$ETC/services/$1.conf" ] || { echo "ext: no service $1" >&2; exit 2; }; inst "$1"; exit ;;
esac
mkdir -p "$TMP/x"
# x.<name>: the cache of versions before the instances
rm -f "$TMP"/x.*
ids=" "
for f in "$ETC"/services/*.conf; do
  [ -f "$f" ] || continue
  id=${f##*/}; id=${id%.conf}
  case "$id" in ""|*[!a-z0-9-]*) continue ;; esac
  ids="$ids$id "
  ( refresh "$id" ) &
done
# instances that are gone
for f in "$TMP"/x/*; do
  [ -f "$f" ] || continue
  id=${f##*/}; id=${id%.new}
  case "$ids" in *" $id "*) ;; *) rm -f "$f" ;; esac
done
for f in "$TMP"/s.*; do
  [ -f "$f" ] || continue
  id=${f##*/}; id=${id#s.}; id=${id%%.*}
  case "$ids" in *" $id "*) ;; *) rm -f "$f" ;; esac
done
# chk.<id>.<key>: the history files of the collectors (kuma, check), and ext.d/check's scratch .chk.<id>.<key>.now;
# .cams.<id> and .ck.<id>: the camera list and login cookie of ext.d/frigate for bin/snap
for f in "$TMP"/chk.* "$TMP"/.chk.* "$TMP"/.cams.* "$TMP"/.ck.*; do
  [ -f "$f" ] || continue
  id=${f##*/}; id=${id#.}; id=${id#chk.}; id=${id#cams.}; id=${id#ck.}; id=${id%%.*}
  case "$ids" in *" $id "*) ;; *) rm -f "$f" ;; esac
done
# camera frames <id>-<n>.jpg and their temps .<id>-<n>.jpg.t (ext.d/frigate): the id is what is left of the name without the number
for f in "$PUB"/cam/*-[0-9].jpg "$PUB"/cam/.*-[0-9].jpg.t; do
  [ -f "$f" ] || continue
  id=${f##*/}; id=${id#.}; id=${id%.t}; id=${id%.jpg}; id=${id%-*}
  case "$ids" in *" $id "*) ;; *) rm -f "$f" ;; esac
done
wait
