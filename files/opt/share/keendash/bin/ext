#!/bin/sh
# Third-party services over their HTTP APIs: one collector per type in ext.d, one run per instance (etc/services/<id>.conf).
# Their APIs can be slow or down, so bin/tick runs this every minute in the background: each instance goes to
# /tmp/keendash/x/<id>, keendashd reads that cache. A collector gets URL USER PASS KEY TOKEN in its environment and prints
# "key value" / "table|a|b" lines; "~key value" lines are also appended to s.<id>.<key> (graph history).
#   ext          refresh the cache for every instance
#   ext <id>     print one instance to stdout (debugging, tests)
PATH=/opt/sbin:/opt/bin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
ETC=${KEENDASH_ETC:-/opt/etc/keendash}
TMP=${KEENDASH_TMP:-/tmp/keendash}
EXTD=${KEENDASH_EXTD:-/opt/share/keendash/ext.d}

# run the collector of one instance; the conf is KEY='value' lines written by bin/settings, so sourcing it is safe
inst() {
  unset TYPE URL USER PASS KEY TOKEN
  . "$ETC/services/$1.conf"
  case "${TYPE:-}" in ""|*[!a-z0-9-]*) return 1 ;; esac
  [ -f "$EXTD/$TYPE" ] || return 1
  export URL USER PASS KEY TOKEN
  # 2>/dev/null: the shell reports a wget killed by its deadline as "Terminated"; || : keeps the cache when a collector exits non-zero
  sh "$EXTD/$TYPE" 2>/dev/null || :
}

# refresh one instance: x/<id> atomically, "~key value" lines into the history files (the last 180)
refresh() {
  inst "$1" > "$TMP/x/$1.new" || { rm -f "$TMP/x/$1.new" "$TMP/x/$1"; return; }
  [ -s "$TMP/x/$1.new" ] || echo "ok 0" > "$TMP/x/$1.new"
  sed -n 's/^~\([a-z0-9_]*\) \(.*\)/\1 \2/p' "$TMP/x/$1.new" | while read -r k v; do
    f="$TMP/s.$1.$k"; { tail -n 179 "$f" 2>/dev/null; echo "$v"; } > "$TMP/.s.$1.$k.t" && mv "$TMP/.s.$1.$k.t" "$f"
  done
  mv "$TMP/x/$1.new" "$TMP/x/$1"
}

case "${1:-}" in
  "") ;;
  *[!a-z0-9-]*) echo "usage: ext [<service id>]" >&2; exit 2 ;;
  *) [ -f "$ETC/services/$1.conf" ] || { echo "ext: no service $1" >&2; exit 2; }; inst "$1"; exit ;;
esac
mkdir -p "$TMP/x"
# x.<name>: the cache of versions before the instances
rm -f "$TMP"/x.*
ids=" "
for f in "$ETC"/services/*.conf; do
  [ -f "$f" ] || continue
  id=${f##*/}; id=${id%.conf}
  case "$id" in ""|*[!a-z0-9-]*) continue ;; esac
  ids="$ids$id "
  ( refresh "$id" ) &
done
# instances that are gone
for f in "$TMP"/x/*; do
  [ -f "$f" ] || continue
  id=${f##*/}; id=${id%.new}
  case "$ids" in *" $id "*) ;; *) rm -f "$f" ;; esac
done
for f in "$TMP"/s.*; do
  [ -f "$f" ] || continue
  id=${f##*/}; id=${id#s.}; id=${id%%.*}
  case "$ids" in *" $id "*) ;; *) rm -f "$f" ;; esac
done
wait
