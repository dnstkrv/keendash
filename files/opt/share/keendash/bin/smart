#!/bin/sh
# SMART of the attached HDDs/SSDs for the System card (bin/tick 5, needs smartmontools).
#   smart disks - sd* block devices that are not removable (USB flash sticks say removable=1)
#   smart [now] - (now: without the 30-minute wait) $D/smart: "disk|name|model|ok|temp|hours|realloc|pending|wear|asleep" per disk that answers SMART
PATH=/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin
SYS=${KEENDASH_SYS:-/sys}
D=${KEENDASH_TMP:-/tmp/keendash}
disks() { for b in "$SYS"/block/sd*; do [ "$(cat "$b/removable" 2>/dev/null)" = 0 ] && echo "${b##*/}"; done; }
[ "$1" = disks ] && { disks; exit 0; }

mkdir -p "$D"
command -v smartctl >/dev/null 2>&1 || { rm -f "$D/smart"; exit 0; }
# at most every 30 min (smartd's default): a disk whose own spin-down timer counts SMART reads still gets to sleep
[ "$1" = now ] || { [ -f "$D/smart.at" ] && [ $(( $(date +%s) - $(date -r "$D/smart.at" +%s) )) -lt 1740 ] && exit 0; }
touch "$D/smart.at"
old=$(cat "$D/smart" 2>/dev/null)
: > "$D/smart.t"
# -n standby,9: a sleeping disk is not woken, smartctl exits 9 instead
try() { j=$(smartctl -n standby,9 -j -H -A -l devstat "$@" "/dev/$n" 2>/dev/null); rc=$?; f=$(printf '%s\n' "$j" | "${0%/*}/keendashd" json); }
for n in $(disks); do
  grep -qx "$n" "$D/smart.no" 2>/dev/null && continue
  try
  case $f in *smart_status.passed*) ;; *) [ $rc = 9 ] || try -d sat ;; esac
  if [ $rc = 9 ]; then
    # asleep: the last reading stays
    printf '%s\n' "$old" | awk -F'|' -v OFS='|' -v n="$n" '$1 == "disk" && $2 == n { $10 = 1; print }' >> "$D/smart.t"
    continue
  fi
  # no SMART on either try (a flash stick saying removable=0; some reset on ATA pass-through): not asked again
  # shortcut: kept until a reboot clears /tmp, so a disk replugged under the same name is skipped too
  case $f in *smart_status.passed*) ;; *) echo "$n" >> "$D/smart.no"; continue ;; esac
  printf '%s\n' "$f" | awk -F'\t' -v n="$n" '
    { split($1, k, ".") }
    $1 == "model_name" { m = $2 } $1 == "model_family" { fam = $2 }
    $1 == "smart_status.passed" { ok = $2 == "true" ? 1 : 0; has = 1 }
    $1 == "temperature.current" { t = $2 }
    $1 == "power_on_time.hours" { h = $2 }
    $1 == "endurance_used.current_percent" { w = $2 }
    $1 == "nvme_smart_health_information_log.percentage_used" { w2 = $2 }
    k[1] == "ata_smart_attributes" && k[4] == "id" { id[k[3]] = $2 }
    k[1] == "ata_smart_attributes" && k[4] == "raw" && k[5] == "value" { rv[k[3]] = $2 }
    END {
      if (!has) exit
      for (i in id) { if (id[i] == 5) re = rv[i]; if (id[i] == 197) pe = rv[i] }
      print "disk|" n "|" (m != "" ? m : fam) "|" ok "|" t "|" h "|" re "|" pe "|" (w != "" ? w : w2) "|0"
    }' >> "$D/smart.t"
done
if [ -s "$D/smart.t" ]; then mv "$D/smart.t" "$D/smart"; else rm -f "$D/smart.t" "$D/smart"; fi
